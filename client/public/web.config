<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://flowdesk-api.raksco.in; connect-src 'self' https://flowdesk-api.raksco.in https://api.brevo.com https://api.openai.com; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self'; object-src 'none';" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <!-- Serve the PWA manifest with its official MIME type (remove first
           avoids a 500 error if the host already defines it) -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
